# Copy to .env on a developer machine. Never commit .env.
DEBUG=1
SECRET_KEY=
# DATABASE_URL=sqlite:///dev.sqlite3 is the default; PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/cw
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/cwtest
# MEDIA_ROOT defaults to a cw_media folder beside the repository
# MEDIA_ROOT=/path/outside/the/repository
ALLOWED_HOSTS=localhost,127.0.0.1
